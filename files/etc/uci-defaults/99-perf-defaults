#!/bin/sh
# Generic AN7581 performance defaults (portable across boards)

uci -q batch <<'UCIEOF'
set firewall.@defaults[0].flow_offloading='1'
set firewall.@defaults[0].flow_offloading_hw='1'
set firewall.@defaults[0].fullcone='1'
set network.wan.sourcefilter='0'
set network.globals.packet_steering='1'
set uhttpd.main.max_requests='16'
commit firewall
commit network
commit uhttpd
UCIEOF

# 把 wan_6 并入 wan 防火墙区域（IPv6 硬件卸载要求）
if ! uci -q get firewall.@zone[1].network | grep -qw 'wan_6'; then
    uci -q add_list firewall.@zone[1].network='wan_6'
    uci -q commit firewall
fi

# 网桥开启 IGMP snooping（若 br-lan 是 device 段）
if uci -q get network.@device[0].name | grep -qw 'br-lan'; then
    uci -q set network.@device[0].igmp_snooping='1'
    uci -q commit network
fi

# 自定义看门狗：sysupgrade 只保留脚本，服务需要重新 enable/start
if [ -x /etc/init.d/dsh-watchdog ]; then
    /etc/init.d/dsh-watchdog enable 2>/dev/null
    /etc/init.d/dsh-watchdog start 2>/dev/null
fi

exit 0
